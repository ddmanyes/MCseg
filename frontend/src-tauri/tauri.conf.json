{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "mcseg",
  "version": "0.1.0",
  "identifier": "com.mcseg.app",
  "build": {
    "frontendDist": "boot-ui",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MCseg — Visium HD 分析平台",
        "width": 1440,
        "height": 920,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/uv"
    ],
    "resources": {
      "../../backend": "app/backend",
      "../../config": "app/config",
      "../../pyproject.toml": "app/pyproject.toml",
      "../../uv.lock": "app/uv.lock",
      "../dist": "app/frontend/dist"
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
