{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "mcseg",
  "version": "0.2.1",
  "identifier": "com.mcseg.app",
  "build": {
    "frontendDist": "boot-ui",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run tauri:prepare"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MCseg — Visium HD 分析平台",
        "width": 1440,
        "height": 920,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/uv"
    ],
    "resources": {
      "build-resources/app": "app"
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
